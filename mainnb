  color: #fff;
}

.button-primary:hover {
  background: var(--purple-dark);
  box-shadow: 0 14px 28px rgba(104, 87, 245, 0.28);
}

.button-secondary {
  border-color: #dfdfda;
  background: rgba(255, 255, 255, 0.72);
  color: var(--ink);
}

.button-secondary:hover {
  border-color: var(--ink);
  background: #fff;
}

.button-quiet {
  min-height: 42px;
  padding: 0 14px;
  border-color: transparent;
  background: #f3f3ef;
  color: var(--muted);
}

.button-quiet:hover {
  background: #e9e9e3;
  color: var(--ink);
}

.button[aria-disabled="true"],
.button.is-disabled {
  cursor: not-allowed;
  opacity: 0.48;
  pointer-events: none;
}

.button svg {
  width: 16px;
  height: 16px;
}

/* Home */
.home-hero {
  position: relative;
  padding: 88px 0 72px;
}

.home-hero::before {
  position: absolute;
  top: -180px;
  right: -160px;
  width: 520px;
  height: 520px;
  border: 1px solid rgba(104, 87, 245, 0.12);
  border-radius: 50%;
  box-shadow: 0 0 0 36px rgba(104, 87, 245, 0.025), 0 0 0 72px rgba(104, 87, 245, 0.02);
  content: "";
  pointer-events: none;
}

.hero-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.06fr) minmax(380px, 0.94fr);
  align-items: center;
  gap: 74px;
}

.hero-copy {
  position: relative;
  z-index: 1;
}

.hero-copy h1 em {
  color: var(--purple);
  font-style: normal;
}

.hero-description {
  max-width: 490px;
  margin: 28px 0 30px;
  color: var(--muted);
  font-size: 1rem;
  line-height: 1.75;
}

.hero-note {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 23px;
  color: var(--soft-muted);
  font-size: 0.72rem;
  font-weight: 700;
}

.hero-note strong {
  color: var(--ink);
}

.avatar-stack {
  display: inline-flex;
}

.avatar-stack span {
  display: grid;
  width: 24px;
  height: 24px;
  margin-left: -6px;
  place-items: center;
  border: 2px solid var(--paper);
  border-radius: 50%;
  color: var(--dark);
  font-size: 0.57rem;
  font-weight: 900;
}

.avatar-stack span:first-child {
  margin-left: 0;
  background: var(--lime);
}

.avatar-stack span:nth-child(2) {
  background: var(--coral);
}

.avatar-stack span:nth-child(3) {
  background: var(--cyan);
}

.hero-art {
  position: relative;
  min-height: 480px;
}

.hero-art::before {
  position: absolute;
  right: 3%;
  bottom: 2%;
  width: 92%;
  height: 88%;
  border-radius: 42% 58% 45% 55% / 48% 38% 62% 52%;
  background: #e9e6ff;
  content: "";
  transform: rotate(-7deg);
}

.hero-art::after {
  position: absolute;
  top: 11%;
  right: -2%;
  width: 118px;
  height: 118px;
  border-radius: 35% 65% 46% 54% / 60% 40% 60% 40%;
  background: var(--lime);
  content: "";
  transform: rotate(22deg);
}

.hero-poster {
  position: absolute;
  z-index: 2;
  top: 4%;
  left: 12%;
  width: 64%;
  height: 82%;
  min-height: 380px;
  overflow: hidden;
  border: 9px solid #fff;
  border-radius: 20px;
  box-shadow: 0 28px 44px rgba(38, 33, 96, 0.2);
  transform: rotate(-6deg);
}

.poster-art {
  position: relative;
  display: flex;
  height: 100%;
  flex-direction: column;
  justify-content: space-between;
  padding: 26px;
  overflow: hidden;
  color: #fff;
}

.poster-art::before,
.poster-art::after {
  position: absolute;
  border: 1px solid rgba(255, 255, 255, 0.26);
  border-radius: 50%;
  content: "";
}

.poster-art::before {
  top: 22%;
  right: -26%;
  width: 116%;
  aspect-ratio: 1;
  box-shadow: 0 0 0 26px rgba(255, 255, 255, 0.07), 0 0 0 52px rgba(255, 255, 255, 0.06);
}

.poster-art::after {
  bottom: -15%;
  left: -22%;
  width: 75%;
  aspect-ratio: 1;
  border-color: rgba(255, 255, 255, 0.18);
}

.poster-art .poster-topline {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 0.58rem;
  font-weight: 850;
  letter-spacing: 0.15em;
  text-transform: uppercase;
}

.poster-art .poster-copy {
  position: relative;
  z-index: 1;
  max-width: 210px;
}

.poster-art .poster-copy span {
  display: block;
  margin-bottom: 9px;
  color: rgba(255, 255, 255, 0.72);
  font-size: 0.66rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.poster-art .poster-copy strong {
  display: block;
  font-size: clamp(2.1rem, 4vw, 3.8rem);
  letter-spacing: -0.09em;
  line-height: 0.88;
}

.poster-art .poster-meta {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 8px;
  color: rgba(255, 255, 255, 0.76);
  font-size: 0.62rem;
  font-weight: 750;
}

.hero-card {
  position: absolute;
  z-index: 3;
  right: 1%;
  bottom: 4%;
  width: 52%;
  padding: 17px;
  border: 1px solid rgba(255, 255, 255, 0.75);
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 18px 38px rgba(31, 28, 80, 0.13);
  backdrop-filter: blur(15px);
  transform: rotate(5deg);
}

.hero-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 14px;
}

.hero-card-top span {
  color: var(--soft-muted);
  font-size: 0.6rem;
  font-weight: 850;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 5px 8px;
  border-radius: 999px;
  background: #f0f7d8;
  color: #4d6420;
  font-size: 0.59rem;
  font-weight: 850;
}

.status-pill::before {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #7ea42a;
  content: "";
}

.hero-card h3 {
  font-size: 1.04rem;
}

.hero-card p {
  margin: 7px 0 0;
  color: var(--muted);
  font-size: 0.7rem;
  line-height: 1.5;
}

.hero-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-top: 16px;
  padding-top: 12px;
  border-top: 1px solid var(--line);
}

.hero-card-footer span {
  color: var(--soft-muted);
  font-size: 0.62rem;
  font-weight: 750;
}

.hero-card-footer a {
  color: var(--purple-dark);
  font-size: 0.68rem;
  font-weight: 850;
}

/* Shared cards and visual language */
.content-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}

.content-card {
  min-width: 0;
}

.content-card.is-hidden {
  display: none;
}

.poster-link {
  display: block;
}

.poster {
  position: relative;
  aspect-ratio: 0.82;
  overflow: hidden;
  border-radius: var(--radius-md);
  box-shadow: 0 12px 22px rgba(16, 20, 47, 0.1);
  transition: box-shadow 180ms ease, transform 180ms ease;
}

.poster-link:hover .poster {
  box-shadow: 0 18px 30px rgba(16, 20, 47, 0.15);
  transform: translateY(-5px) rotate(-1deg);
}

.poster::before,
.poster::after {
  position: absolute;
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  content: "";
}

.poster::before {
  top: -24%;
  right: -38%;
  width: 125%;
  aspect-ratio: 1;
  box-shadow: 0 0 0 18px rgba(255, 255, 255, 0.07), 0 0 0 36px rgba(255, 255, 255, 0.06);
}

.poster::after {
  bottom: -28%;
  left: -25%;
  width: 68%;
  aspect-ratio: 1;
  border-color: rgba(255, 255, 255, 0.18);
}

.poster-content {
  position: relative;
  z-index: 1;
  display: flex;
  height: 100%;
  flex-direction: column;
  justify-content: space-between;
  padding: 17px;
  color: #fff;
}

.poster-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  color: rgba(255, 255, 255, 0.78);
  font-size: 0.57rem;
  font-weight: 850;
  letter-spacing: 0.11em;
  text-transform: uppercase;
}

.poster-number {
  opacity: 0.65;
}

.poster-title {
  display: block;
  max-width: 180px;
  font-size: clamp(1.35rem, 2.8vw, 2.2rem);
  font-weight: 880;
  letter-spacing: -0.085em;
  line-height: 0.9;
}

.poster-meta {
  display: flex;
  gap: 6px;
  color: rgba(255, 255, 255, 0.72);
  font-size: 0.58rem;
  font-weight: 750;
}

.poster-badge {
  position: absolute;
  z-index: 2;
  top: 12px;
  right: 12px;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 6px 8px;
  border-radius: 999px;
  background: rgba(11, 16, 32, 0.25);
  color: #fff;
  font-size: 0.57rem;
  font-weight: 850;
  backdrop-filter: blur(8px);
}

.poster-badge::before {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: currentColor;
  content: "";
}

.poster.violet,
.poster-art.violet {
  background: linear-gradient(145deg, #29204e, #7359da 52%, #c5a9ee);
}

.poster.cyan {
  background: linear-gradient(145deg, #173e55, #2aaeb1 54%, #b5efe3);
}

.poster.peach {
  background: linear-gradient(145deg, #672a45, #db6c70 53%, #ffca99);
}

.poster.amber {
  background: linear-gradient(145deg, #5a2718, #d98136 55%, #f7cf72);
}

.poster.lime {
  background: linear-gradient(145deg, #29482e, #7eaf53 50%, #d6e871);
}

.poster.blue {
  background: linear-gradient(145deg, #192c5a, #4777bb 55%, #b0e4e9);
}

.poster.mint {
  background: linear-gradient(145deg, #17484c, #3aa995 52%, #c9f2bb);
}

.poster.rose {
  background: linear-gradient(145deg, #63283d, #c85a7a 52%, #f5b3b5);
}

.poster.slate {
  background: linear-gradient(145deg, #182436, #4c6780 54%, #b6c5cf);
}

.poster.indigo {
  background: linear-gradient(145deg, #20234f, #5f6fc4 54%, #c7bdf0);
}

.card-copy {
  padding: 14px 4px 0;
}

.card-copy h3 {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-copy p {
  margin: 7px 0 0;
  color: var(--muted);
  font-size: 0.73rem;
  line-height: 1.45;
}

.card-copy .card-meta {
  display: flex;
  align-items: center;
  gap: 7px;
  color: var(--soft-muted);
  font-size: 0.64rem;
  font-weight: 750;
}

.card-meta-dot {
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background: #b5b6bd;
}

.rail {
  display: grid;
  grid-auto-columns: minmax(194px, 1fr);
  grid-auto-flow: column;
  gap: 18px;
  overflow-x: auto;
  padding: 5px 2px 18px;
  scrollbar-color: #d3d3cd transparent;
  scrollbar-width: thin;
}

.rail .content-card {
  width: 100%;
}

.category-grid {
  display: grid;
  grid-template-columns: 1.22fr 0.78fr 0.92fr;
  gap: 18px;
}

.category-tile {
  position: relative;
  min-height: 220px;
  overflow: hidden;
  padding: 24px;
  border-radius: var(--radius-lg);
  isolation: isolate;
}

.category-tile::before {
  position: absolute;
  z-index: -1;
  top: -28%;
  right: -12%;
  width: 78%;
  aspect-ratio: 1;
  border: 1px solid rgba(255, 255, 255, 0.32);
  border-radius: 50%;
  box-shadow: 0 0 0 18px rgba(255, 255, 255, 0.1), 0 0 0 36px rgba(255, 255, 255, 0.08);
  content: "";
}

.category-tile::after {
  position: absolute;
  z-index: -1;
  right: 12%;
  bottom: -24%;
  width: 36%;
  aspect-ratio: 1;
  border: 1px solid rgba(255, 255, 255, 0.26);
  border-radius: 50%;
  content: "";
}

.category-tile h3 {
  max-width: 180px;
  font-size: 1.8rem;
  letter-spacing: -0.075em;
}

.category-tile p {
  max-width: 210px;
  margin: 12px 0 0;
  color: rgba(255, 255, 255, 0.74);
  font-size: 0.76rem;
  line-height: 1.5;
}

.category-tile a {
  position: absolute;
  bottom: 22px;
  left: 24px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #fff;
  font-size: 0.72rem;
  font-weight: 850;
}

.category-tile a span {
  transition: transform 160ms ease;
}

.category-tile a:hover span {
  transform: translateX(4px);
}

.category-tile.anime {
  min-height: 310px;
  background: linear-gradient(135deg, #2c2158, #7f67e6 60%, #b9a8ee);
  color: #fff;
}

.category-tile.serials {
  background: linear-gradient(135deg, #0d3f4b, #4eb7b1);
  color: #fff;
}

.category-tile.study {
  background: linear-gradient(135deg, #f0eecc, #d5df92);
  color: var(--ink);
}

.category-tile.study p,
.category-tile.study a {
  color: rgba(23, 27, 49, 0.68);
}

.category-tile.study a {
  color: var(--ink);
}

.feature-banner {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 0.65fr;
  gap: 35px;
  min-height: 280px;
  padding: 40px;
  border-radius: var(--radius-lg);
  background: var(--dark);
  color: #fff;
}

.feature-banner .eyebrow {
  color: var(--lime);
}

.feature-banner h2 {
  max-width: 500px;
  font-size: clamp(2.3rem, 4.8vw, 4.5rem);
}

.feature-banner p {
  max-width: 450px;
  margin: 20px 0 0;
  color: rgba(229, 232, 255, 0.67);
  font-size: 0.88rem;
  line-height: 1.65;
}

.feature-banner .button-secondary {
  border-color: rgba(255, 255, 255, 0.2);
  background: rgba(255, 255, 255, 0.08);
  color: #fff;
}

.feature-banner .button-secondary:hover {
  border-color: rgba(255, 255, 255, 0.6);
  background: rgba(255, 255, 255, 0.15);
}

.feature-stat-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  align-self: center;
}

.feature-stat {
  min-height: 104px;
  padding: 18px;
  border: 1px solid rgba(255, 255, 255, 0.13);
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.06);
}

.feature-stat strong {
  display: block;
  color: var(--lime);
  font-size: 1.8rem;
  letter-spacing: -0.08em;
}

.feature-stat span {
  display: block;
  margin-top: 7px;
  color: rgba(229, 232, 255, 0.62);
  font-size: 0.68rem;
  line-height: 1.3;
}

/* Explore and collection pages */
.page-hero {
  padding: 78px 0 52px;
  background:
    linear-gradient(120deg, rgba(218, 250, 114, 0.22), transparent 38%),
    linear-gradient(300deg, rgba(146, 232, 226, 0.18), transparent 40%);
}

.page-hero-inner {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 40px;
}

.page-hero h1 {
  max-width: 670px;
  font-size: clamp(3rem, 6.6vw, 5.9rem);
}

.page-hero-copy {
  max-width: 420px;
  margin: 21px 0 0;
  color: var(--muted);
  font-size: 0.94rem;
  line-height: 1.7;
}

.page-hero-mark {
  position: relative;
  flex: 0 0 auto;
  width: 175px;
  height: 175px;
  border-radius: 50%;
  background: var(--purple);
  box-shadow: 0 0 0 18px rgba(104, 87, 245, 0.1), 0 0 0 36px rgba(104, 87, 245, 0.05);
}

.page-hero-mark::before,
.page-hero-mark::after {
  position: absolute;
  border: 1px solid rgba(255, 255, 255, 0.42);
  border-radius: 50%;
  content: "";
}

.page-hero-mark::before {
  inset: 22px;
}

.page-hero-mark::after {
  inset: 45px;
  background: var(--lime);
}

.filter-bar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  margin-bottom: 34px;
}

.filter-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.filter-chip {
  min-height: 38px;
  padding: 0 14px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: var(--panel);
  color: var(--muted);
  font-size: 0.72rem;
  font-weight: 800;
  transition: background 160ms ease, border-color 160ms ease, color 160ms ease;
}

.filter-chip:hover,
.filter-chip.is-active {
  border-color: var(--ink);
  background: var(--ink);
  color: #fff;
}

.search-box {
  position: relative;
  width: min(100%, 250px);
}

.search-box svg {
  position: absolute;
  top: 50%;
  left: 13px;
  width: 15px;
  height: 15px;
  color: var(--soft-muted);
  pointer-events: none;
  transform: translateY(-50%);
}

.search-box input {
  width: 100%;
  min-height: 40px;
  padding: 0 14px 0 38px;
  border: 1px solid var(--line);
  border-radius: 999px;
  outline: none;
  background: var(--panel);
  color: var(--ink);
  font-size: 0.75rem;
  transition: border-color 160ms ease, box-shadow 160ms ease;
}

.search-box input:focus {
  border-color: var(--purple);
  box-shadow: 0 0 0 4px rgba(104, 87, 245, 0.1);
}

.result-count {
  margin: 0 0 18px;
  color: var(--soft-muted);
  font-size: 0.72rem;
  font-weight: 750;
}

.empty-state {
  display: none;
  padding: 48px 24px;
  border: 1px dashed #cfd1ca;
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.55);
  text-align: center;
}

.empty-state.is-visible {
  display: block;
}

.empty-state h3 {
  font-size: 1.5rem;
}

.empty-state p {
  max-width: 380px;
  margin: 11px auto 0;
  color: var(--muted);
  font-size: 0.82rem;
  line-height: 1.6;
}

.collection-intro {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 32px;
  align-items: end;
  margin-bottom: 36px;
}

.collection-intro p {
  max-width: 390px;
  margin: 0;
  color: var(--muted);
  font-size: 0.9rem;
  line-height: 1.7;
}

.watch-spotlight {
  display: grid;
  grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
  gap: 34px;
  align-items: stretch;
  padding: 30px;
  border-radius: var(--radius-lg);
  background: linear-gradient(125deg, #261b4d, #5f51bc);
  color: #fff;
}

.watch-spotlight .poster {
  max-width: 260px;
  justify-self: center;
  border: 5px solid rgba(255, 255, 255, 0.16);
  box-shadow: none;
}

.watch-spotlight-copy {
  align-self: center;
  padding: 12px 0;
}

.watch-spotlight-copy .eyebrow {
  color: var(--lime);
}

.watch-spotlight-copy h2 {
  max-width: 480px;
  font-size: clamp(2.3rem, 5vw, 4.5rem);
}

.watch-spotlight-copy > p:not(.eyebrow) {
  max-width: 480px;
  margin: 22px 0 25px;
  color: rgba(255, 255, 255, 0.7);
  font-size: 0.9rem;
  line-height: 1.7;
}

.watch-spotlight .button-secondary {
  border-color: rgba(255, 255, 255, 0.24);
  background: rgba(255, 255, 255, 0.09);
  color: #fff;
}

.watch-spotlight .button-secondary:hover {
  border-color: rgba(255, 255, 255, 0.65);
  background: rgba(255, 255, 255, 0.16);
}

.watchlist-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  margin-top: 24px;
  padding: 18px 20px;
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  background: var(--panel);
}

.watchlist-strip strong {
  display: block;
  font-size: 0.86rem;
}

.watchlist-strip p {
  margin: 5px 0 0;
  color: var(--muted);
  font-size: 0.72rem;
}

.saved-count {
  display: inline-grid;
  min-width: 28px;
  height: 28px;
  margin-left: 5px;
  place-items: center;
  border-radius: 50%;
  background: var(--lime);
  color: var(--dark);
  font-size: 0.7rem;
  font-weight: 900;
}

/* Detail page */
.detail-page {
  padding: 62px 0 92px;
}

.back-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 38px;
  color: var(--muted);
  font-size: 0.75rem;
  font-weight: 800;
}

.back-link:hover {
  color: var(--ink);
}

.detail-grid {
  display: grid;
  grid-template-columns: minmax(260px, 0.62fr) minmax(0, 1.38fr);
  gap: clamp(34px, 7vw, 90px);
  align-items: start;
}

.detail-poster {
  max-width: 360px;
  margin: 0 auto;
}

.detail-poster .poster {
  box-shadow: var(--shadow);
}

.detail-copy {
  padding-top: 9px;
}

.detail-copy h1 {
  max-width: 720px;
  font-size: clamp(3rem, 6vw, 6.2rem);
}

.detail-copy > .detail-summary {
  max-width: 630px;
  margin: 27px 0 30px;
  color: var(--muted);
  font-size: 1rem;
  line-height: 1.78;
}

.detail-meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 9px 18px;
  margin-bottom: 31px;
  color: var(--soft-muted);
  font-size: 0.73rem;
  font-weight: 750;
}

.detail-meta-row span {
  display: inline-flex;
  align-items: center;
  gap: 7px;
}

.detail-meta-row span::before {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--purple);
  content: "";
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin-top: 31px;
}

.tag {
  padding: 7px 10px;
  border-radius: 999px;
  background: #f0f0eb;
  color: var(--muted);
  font-size: 0.64rem;
  font-weight: 800;
}

.detail-source-note {
  display: flex;
  align-items: flex-start;
  gap: 11px;
  max-width: 620px;
  margin-top: 35px;
  padding: 14px 16px;
  border-radius: 14px;
  background: #f3f5e5;
  color: #68743e;
  font-size: 0.72rem;
  line-height: 1.5;
}

.detail-source-note strong {
  color: #4f5e1c;
}

.detail-source-note svg {
  width: 17px;
  height: 17px;
  flex: 0 0 auto;
  margin-top: 1px;
}

.not-found {
  padding: 130px 0;
  text-align: center;
}

.not-found h1 {
  margin: 0 auto;
  font-size: clamp(3rem, 7vw, 6rem);
}

.not-found p {
  max-width: 420px;
  margin: 22px auto 28px;
  color: var(--muted);
  line-height: 1.7;
}

/* Learn page */
.learn-layout {
  display: grid;
  grid-template-columns: minmax(0, 1.08fr) minmax(280px, 0.92fr);
  gap: 24px;
  align-items: stretch;
}

.study-planner {
  padding: 30px;
  border-radius: var(--radius-lg);
  background: #eff2d5;
}

.study-planner h2 {
  max-width: 420px;
  font-size: clamp(2.1rem, 4vw, 3.7rem);
}

.study-planner > p {
  max-width: 430px;
  margin: 17px 0 28px;
  color: rgba(23, 27, 49, 0.64);
  font-size: 0.86rem;
  line-height: 1.65;
}

.planner-list {
  display: grid;
  gap: 9px;
}

.planner-item {
  display: grid;
  grid-template-columns: 34px 1fr auto;
  align-items: center;
  gap: 12px;
  min-height: 58px;
  padding: 10px 13px;
  border: 1px solid rgba(23, 27, 49, 0.09);
  border-radius: 13px;
  background: rgba(255, 255, 255, 0.48);
}

.planner-number {
  display: grid;
  width: 30px;
  height: 30px;
  place-items: center;
  border-radius: 10px;
  background: var(--dark);
  color: var(--lime);
  font-size: 0.68rem;
  font-weight: 900;
}

.planner-item strong {
  display: block;
  font-size: 0.76rem;
}

.planner-item small {
  display: block;
  margin-top: 3px;
  color: rgba(23, 27, 49, 0.58);
  font-size: 0.64rem;
}

.planner-time {
  color: rgba(23, 27, 49, 0.58);
  font-size: 0.64rem;
  font-weight: 800;
}

.study-note {
  position: relative;
  min-height: 100%;
  overflow: hidden;
  padding: 30px;
  border-radius: var(--radius-lg);
  background: var(--dark);
  color: #fff;
}

.study-note::before {
  position: absolute;
  top: -70px;
  right: -70px;
  width: 240px;
  height: 240px;
  border: 1px solid rgba(218, 250, 114, 0.42);
  border-radius: 50%;
  box-shadow: 0 0 0 20px rgba(218, 250, 114, 0.08), 0 0 0 40px rgba(218, 250, 114, 0.05);
  content: "";
}

.study-note h2 {
  position: relative;
  z-index: 1;
  max-width: 300px;
  font-size: clamp(2.2rem, 4vw, 3.8rem);
}

.study-note p {
  position: relative;
  z-index: 1;
  max-width: 330px;
  margin: 18px 0 0;
  color: rgba(229, 232, 255, 0.68);
  font-size: 0.84rem;
  line-height: 1.65;
}

.study-note .button {
  position: relative;
  z-index: 1;
  margin-top: 28px;
}

.learn-library {
  margin-top: 80px;
}

/* About page */
.about-layout {
  display: grid;
  grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
  gap: 60px;
  align-items: start;
}

.about-lead h1 {
  max-width: 500px;
  font-size: clamp(3rem, 6vw, 5.8rem);
}

.about-lead > p:not(.eyebrow) {
  max-width: 430px;
  margin: 24px 0 0;
  color: var(--muted);
  font-size: 0.95rem;
  line-height: 1.75;
}

.about-stack {
  display: grid;
  gap: 13px;
}

.about-card {
  padding: 23px 24px;
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  background: var(--panel);
}

.about-card.highlight {
  border-color: transparent;
  background: var(--dark);
  color: #fff;
}

.about-card h2 {
  font-size: 1.45rem;
  letter-spacing: -0.06em;
}

.about-card p {
  margin: 10px 0 0;
  color: var(--muted);
  font-size: 0.8rem;
  line-height: 1.65;
}

.about-card.highlight p {
  color: rgba(229, 232, 255, 0.68);
}

.step-list {
  display: grid;
  gap: 12px;
  margin-top: 19px;
}

.step {
  display: grid;
  grid-template-columns: 31px 1fr;
  gap: 11px;
  align-items: start;
}

.step-index {
  display: grid;
  width: 27px;
  height: 27px;
  place-items: center;
  border-radius: 9px;
  background: var(--lime);
  color: var(--dark);
  font-size: 0.65rem;
  font-weight: 900;
}

.step strong {
  display: block;
  font-size: 0.77rem;
}

.step p {
  margin-top: 3px;
  font-size: 0.7rem;
}

.rights-callout {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 13px;
  align-items: start;
  margin-top: 24px;
  padding: 18px;
  border-radius: 15px;
  background: #fff6df;
  color: #755f2c;
}

.rights-callout svg {
  width: 19px;
  height: 19px;
  margin-top: 1px;
}

.rights-callout strong {
  display: block;
  color: #5c481c;
  font-size: 0.75rem;
}

.rights-callout p {
  margin: 4px 0 0;
  color: #876f36;
  font-size: 0.71rem;
  line-height: 1.55;
}

.contact-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  margin-top: 64px;
  padding: 24px;
  border-radius: var(--radius-md);
  background: var(--purple);
  color: #fff;
}

.contact-strip strong {
  display: block;
  font-size: 1.05rem;
}

.contact-strip p {
  margin: 6px 0 0;
  color: rgba(255, 255, 255, 0.72);
  font-size: 0.75rem;
}

.contact-strip .button-secondary {
  border-color: rgba(255, 255, 255, 0.26);
  background: rgba(255, 255, 255, 0.12);
  color: #fff;
}

.contact-strip .button-secondary:hover {
  border-color: #fff;
  background: rgba(255, 255, 255, 0.2);
}

/* Footer */
.site-footer {
  margin-top: 34px;
  padding: 55px 0 24px;
  border-top: 1px solid var(--line);
  background: #f3f3ee;
}

.footer-grid {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 40px;
  padding-bottom: 48px;
}

.footer-brand .brand-mark {
  width: 31px;
  height: 31px;
  border-radius: 10px 10px 10px 4px;
  font-size: 1.3rem;
}

.footer-note {
  max-width: 270px;
  margin: 18px 0 0;
  color: var(--muted);
  font-size: 0.75rem;
  line-height: 1.6;
}

.footer-links {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 28px;
}

.footer-links > div {
  display: grid;
  align-content: start;
  gap: 10px;
}

.footer-heading {
  margin: 0 0 3px;
  color: var(--ink);
  font-size: 0.68rem;
  font-weight: 850;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.footer-links a {
  color: var(--muted);
  font-size: 0.75rem;
}

.footer-links a:hover {
  color: var(--purple-dark);
}

.footer-bottom {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  padding-top: 20px;
  border-top: 1px solid #dfdfda;
  color: var(--soft-muted);
  font-size: 0.65rem;
  font-weight: 700;
}

.noscript-message {
  position: fixed;
  z-index: 99;
  right: 16px;
  bottom: 16px;
  max-width: 360px;
  padding: 16px;
  border-radius: 12px;
  background: #fff6df;
  box-shadow: var(--shadow);
  color: #755f2c;
  font-size: 0.8rem;
}

@media (max-width: 980px) {
  .hero-grid {
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.8fr);
    gap: 35px;
  }

  .hero-art {
    min-height: 390px;
  }

  .hero-poster {
    min-height: 315px;
  }

  .content-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .category-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .category-tile.anime {
    grid-row: span 2;
    min-height: 460px;
  }

  .feature-banner {
    grid-template-columns: minmax(0, 1fr) 0.8fr;
  }
}

@media (max-width: 760px) {
  .container {
    width: min(calc(100% - 34px), var(--container));
  }

  .announcement-inner {
    min-height: 34px;
    font-size: 0.66rem;
  }

  .announcement-inner a {
    display: none;
  }

  .topbar-inner {
    min-height: 68px;
    gap: 12px;
  }

  .mobile-menu-button {
    display: block;
  }

  .primary-navigation {
    position: absolute;
    top: 68px;
    right: 17px;
    left: 17px;
    display: none;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    padding: 8px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.97);
    box-shadow: var(--shadow);
  }

  .primary-navigation.is-open {
    display: flex;
  }

  .primary-navigation a {
    padding: 13px 14px;
    border-radius: 10px;
  }

  .primary-navigation a::after {
    right: auto;
    bottom: auto;
    left: 4px;
    width: 3px;
    height: 18px;
    border-radius: 3px;
    transform: scaleY(0.45);
  }

  .primary-navigation a.is-active {
    background: #f5f4ff;
  }

  .primary-navigation a.is-active::after {
    transform: scaleY(1);
  }

  .drive-pill {
    margin-left: 0;
    padding: 0 10px;
    font-size: 0;
  }

  .drive-icon {
    width: 24px;
    height: 24px;
  }

  .drive-icon svg {
    width: 17px;
    height: 17px;
  }

  .home-hero {
    padding: 68px 0 56px;
  }

  .hero-grid,
  .learn-layout,
  .about-layout,
  .collection-intro,
  .detail-grid {
    grid-template-columns: 1fr;
  }

  .hero-grid {
    gap: 42px;
  }

  h1 {
    font-size: clamp(3.35rem, 15vw, 5.7rem);
  }

  .hero-art {
    width: min(100%, 480px);
    min-height: 410px;
    margin: 0 auto;
  }

  .page-section {
    padding: 64px 0;
  }

  .section-heading {
    display: block;
    margin-bottom: 24px;
  }

  .section-heading > p {
    margin-top: 14px;
  }

  .section-link {
    margin-top: 17px;
  }

  .content-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px 13px;
  }

  .category-grid {
    grid-template-columns: 1fr;
  }

  .category-tile.anime {
    grid-row: auto;
    min-height: 280px;
  }

  .category-tile {
    min-height: 210px;
  }

  .feature-banner {
    grid-template-columns: 1fr;
    padding: 27px;
  }

  .feature-stat-grid {
    margin-top: 2px;
  }

  .page-hero {
    padding: 57px 0 42px;
  }

  .page-hero-inner {
    display: block;
  }

  .page-hero-mark {
    display: none;
  }

  .filter-bar {
    display: block;
  }

  .search-box {
    width: 100%;
    margin-top: 14px;
  }

  .watch-spotlight {
    grid-template-columns: 1fr;
    gap: 24px;
    padding: 22px;
  }

  .watch-spotlight .poster {
    width: min(100%, 240px);
  }

  .watch-spotlight-copy {
    padding: 0;
  }

  .watchlist-strip,
  .contact-strip {
    display: block;
  }

  .watchlist-strip .button,
  .contact-strip .button {
    margin-top: 15px;
  }

  .detail-page {
    padding: 46px 0 68px;
  }

  .detail-poster {
    width: min(72vw, 290px);
  }

  .detail-copy h1 {
    font-size: clamp(3rem, 15vw, 5rem);
  }

  .learn-library {
    margin-top: 58px;
  }

  .about-layout {
    gap: 38px;
  }

  .contact-strip {
    margin-top: 48px;
  }

  .footer-grid {
    grid-template-columns: 1fr;
    gap: 35px;
  }

  .footer-bottom {
    display: grid;
    gap: 7px;
  }
}

@media (max-width: 430px) {
  .container {
    width: min(calc(100% - 28px), var(--container));
  }

  .brand-copy small {
    display: none;
  }

  .hero-art {
    min-height: 330px;
  }

  .hero-poster {
    min-height: 270px;
    border-width: 6px;
  }

  .hero-card {
    right: 0;
    width: 58%;
    padding: 13px;
  }

  .hero-card p {
    font-size: 0.64rem;
  }

  .poster-content {
    padding: 13px;
  }

  .poster-title {
    font-size: 1.5rem;
  }

  .poster-label,
  .poster-meta {
    font-size: 0.5rem;
  }

  .planner-item {
    grid-template-columns: 30px 1fr;
  }

  .planner-time {
    display: none;
  }

  .footer-links {
    gap: 16px;
  }
}

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b1020" />
    <meta
      name="description"
      content="Kairo is a public, rights-cleared library for films, serials, and study resources."
    />
    <title>Kairo — play, learn, keep</title>
    <link rel="stylesheet" href="styles.css" />
  </head>
  <body>
    <div class="app-shell">
      <div class="announcement-bar">
        <div class="container announcement-inner">
          <span class="announcement-dot" aria-hidden="true"></span>
          <p>One calm place for your watchlist and study queue.</p>
          <a href="#/about">How the library works <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <header class="topbar">
        <div class="container topbar-inner">
          <a class="brand" href="#/" aria-label="Kairo home">
            <span class="brand-mark" aria-hidden="true">k</span>
            <span class="brand-copy">
              <strong>kairo</strong>
              <small>play · learn · keep</small>
            </span>
          </a>

          <button
            class="mobile-menu-button"
            id="mobile-menu-button"
            type="button"
            aria-controls="primary-navigation"
            aria-expanded="false"
          >
            <span class="sr-only">Toggle navigation</span>
            <span></span><span></span>
          </button>

          <nav class="primary-navigation" id="primary-navigation" aria-label="Primary navigation">
            <a data-nav-link href="#/">Home</a>
            <a data-nav-link href="#/explore">Explore</a>
            <a data-nav-link href="#/watch">Watch</a>
            <a data-nav-link href="#/learn">Learn</a>
            <a data-nav-link href="#/about">About</a>
          </nav>

          <a class="drive-pill" id="header-drive-link" href="#/about">
            <span class="drive-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" role="img">
                <path d="M8.2 3h7.6l5.4 9.35-3.8 6.6H9.8L4.4 9.6 8.2 3Z" fill="none" stroke="currentColor" stroke-width="1.8" />
                <path d="m8.2 3 5.55 9.6M4.4 9.6h10.95m2.05 9.35 2.8-6.6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8" />
              </svg>
            </span>
            <span id="header-drive-label">Connect Drive</span>
          </a>
        </div>
      </header>

      <main id="app-main" tabindex="-1"></main>

      <footer class="site-footer">
        <div class="container footer-grid">
          <div>
            <a class="brand footer-brand" href="#/" aria-label="Kairo home">
              <span class="brand-mark" aria-hidden="true">k</span>
              <span class="brand-copy">
                <strong>kairo</strong>
                <small>play · learn · keep</small>
              </span>
            </a>
            <p class="footer-note">A lightweight public library for authorised media and useful study material.</p>
          </div>
          <div class="footer-links">
            <div>
              <p class="footer-heading">Browse</p>
              <a href="#/explore">All library</a>
              <a href="#/watch">Watch</a>
              <a href="#/learn">Learn</a>
            </div>
            <div>
              <p class="footer-heading">Keep it safe</p>
              <a href="#/about">Drive setup</a>
              <a href="#/about#rights">Rights notice</a>
              <a href="#/about#contact">Contact</a>
            </div>
          </div>
        </div>
        <div class="container footer-bottom">
          <span>© <span id="current-year"></span> Kairo</span>
          <span>Built for GitHub Pages · no account required</span>
        </div>
      </footer>
    </div>

    <noscript>
      <div class="noscript-message">
        Kairo needs JavaScript for page switching, search, and the saved list. Please enable JavaScript to use the library.
      </div>
    </noscript>

    <script src="content.js"></script>
    <script src="app.js"></script>
  </body>
</html>
