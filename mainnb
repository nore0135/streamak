  function renderWatchSpotlight(item) {
    return `
      <div class="watch-spotlight">
        <div>${renderPoster(item, 0)}</div>
        <div class="watch-spotlight-copy">
          <p class="eyebrow">Spotlight · ${escapeHtml(item.label)}</p>
          <h2>${escapeHtml(item.title)}</h2>
